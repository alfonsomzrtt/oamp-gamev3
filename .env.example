# =============================================================================
#  Block Design Test — Desktop App Environment Variables
#  Ajang Lomba & Tes Kognitif
#  Salin file ini menjadi .env lalu isi nilainya
# =============================================================================


# ── Multiplayer / API Server ──────────────────────────────────────────────────

# URL server Next.js tempat data dikirim (Vercel atau localhost saat dev)
# Kosongkan agar aplikasi berjalan offline tanpa mengirim data ke server
API_SERVER_URL=https://api.zerodian.dev/api/v1
#API_SERVER_URL=http://localhost:8080
#API_SERVER_URL=https://192.168.3.6
# PC role: "competition" (default) = duel / tournament mode selection after UID scan
#          "training" = langsung masuk TimeIn, UID opsional (guest mode)
PC_MODE=competition

# Fallback room ID — hanya berlaku jika TIDAK menggunakan GUI lobby multiplayer
# (saat menggunakan mode multiplayer via GUI, nilai ini diabaikan otomatis)
ROOM_ID=room_01

# Fallback nomor pemain: 1 = PC1, 2 = PC2
# (saat menggunakan mode multiplayer via GUI, nilai ini diabaikan otomatis)
PLAYER_NUM=1


# ── Tampilan & Kamera ─────────────────────────────────────────────────────────

# Tema UI: "dark" (hitam) atau "light" (putih) — restart diperlukan setelah ubah
THEME=dark

# Tampilkan kamera di paruh layar (true) atau full (false)
DISPLAY_HALF=true

# Sembunyikan feed kamera sepenuhnya — hanya tampilkan soal dan timer
HIDE_CAMERA=false

# Gunakan susunan pola BDT standar
NORMAL_PATTERN=true

# ── Kamera ────────────────────────────────────────────────────────────────────

# Indeks kamera (0 = kamera default, 1 = kamera kedua, dst.)
# Bisa dipilih dari menu Pengaturan Kamera di layar utama
CAMERA_INDEX=0

# Cermin sumbu X (horizontal flip) — true jika kamera mirror
CAMERA_MIRROR_X=true

# Cermin sumbu Y (vertical flip)
CAMERA_MIRROR_Y=false

# Zoom kamera: 0.5–3.0 (1.0 = normal, 2.0 = 2x zoom in, 0.5 = zoom out)
CAMERA_ZOOM=1.0


# ── Konfigurasi Tes ───────────────────────────────────────────────────────────

# Jumlah level yang dimainkan: 1–8 (default: 8 = semua level)
MAX_LEVEL=8

# Urutan soal kustom (opsional — kosongkan untuk acak)
# Format: "posisi:soal", pisah koma. Contoh: 1:2a,2:3b,3:1c
CUSTOM_LEVEL=

# Mode tombol fisik via ESP32: tampilkan gambar soal 5 detik lalu sembunyikan
# true membutuhkan perangkat ESP32 terhubung lewat serial
BUTTON_MODE=false


# ── Performa YOLO & MediaPipe ─────────────────────────────────────────────────

# Proses YOLO setiap N+1 frame (0=tiap frame, 2=tiap 3 frame — lebih hemat CPU)
# Rekomendasi PC biasa: 2–3 | Jetson Xavier AGX: 1–2
YOLO_SKIP_FRAMES=2

# Proses MediaPipe setiap N+1 frame
# Set ke 10+ jika deteksi tangan tidak dibutuhkan
MEDIAPIPE_SKIP_FRAMES=2

# Gunakan model bantal.pt (true) atau model default best.pt (false)
MODEL_BANTAL=false

# Mode debug: tampilkan metrik performa detail di console
DEBUG_MODE=false


# ── Database Lokal (tidak lagi diperlukan) ────────────────────────────────────
# Variabel DB_* di bawah hanya dibutuhkan jika masih menggunakan sistem SQL
# lokal (cron/sql/). Sejak integrasi API server (API_SERVER_URL), data peserta
# dikirim langsung ke server sehingga koneksi database lokal tidak diperlukan.

# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=bdt_db
# DB_USERNAME=postgres
# DB_PASSWORD=your_password_here
# DB_SSL=false
